# Exercise the override path before clean-tag or automatic-download eligibility.
function(expect_override name id variant version fixture want)
    cmake_parse_arguments(PARSE_ARGV 6 CASE "DEFAULT_CRT" "CRT;DISABLED_RUNTIME;BUILD_TYPE;CONFIGURATIONS;MULTICONFIG" "")
    set(CMAKE_SOURCE_DIR "${_tmp}/consumer")
    set(CMAKE_CURRENT_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
    set(CMAKE_CONFIGURATION_TYPES "${CASE_CONFIGURATIONS}")
    set(COMMONLIB_PREBUILT_MULTICONFIG "${CASE_MULTICONFIG}")
    set(CMAKE_BUILD_TYPE Release)
    if(DEFINED CASE_BUILD_TYPE)
        set(CMAKE_BUILD_TYPE "${CASE_BUILD_TYPE}")
    endif()
    set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
    if(CASE_DEFAULT_CRT)
        unset(CMAKE_MSVC_RUNTIME_LIBRARY)
    elseif(DEFINED CASE_CRT)
        set(CMAKE_MSVC_RUNTIME_LIBRARY "${CASE_CRT}")
    endif()
    set(ENABLE_SKYRIM_SE ON)
    set(ENABLE_SKYRIM_AE ON)
    set(ENABLE_SKYRIM_VR ON)
    if(CASE_DISABLED_RUNTIME)
        set(ENABLE_SKYRIM_${CASE_DISABLED_RUNTIME} OFF)
    endif()
    set(CMAKE_CXX_COMPILER_ID "${id}")
    set(CMAKE_CXX_COMPILER_FRONTEND_VARIANT "${variant}")
    set(CMAKE_CXX_COMPILER_VERSION "${version}")
    set(COMMONLIB_PREBUILT_DIR "${_tmp}/${fixture}")
    commonlib_resolve_prebuilt(got)
    set(expected "")
    if(want)
        set(expected "${COMMONLIB_PREBUILT_DIR}")
    endif()
    if(got STREQUAL expected)
        message(STATUS "PASS ${name}")
    else()
        message(SEND_ERROR "FAIL ${name}: resolved='${got}', expected '${expected}'")
    endif()
endfunction()

