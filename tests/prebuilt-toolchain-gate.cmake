# Run with cmake -P tests/prebuilt-toolchain-gate.cmake; no compiler or network is required.
cmake_minimum_required(VERSION 3.19)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/Prebuilt.cmake")

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _run_id)
set(_tmp "${CMAKE_CURRENT_BINARY_DIR}/build/tests/prebuilt-toolchain-gate-${_run_id}")
if(EXISTS "${_tmp}")
    message(FATAL_ERROR "Refusing to reuse an existing fixture directory: ${_tmp}")
endif()

function(bundle name family version)
    set(dir "${_tmp}/${name}")
    file(MAKE_DIRECTORY "${dir}/include" "${dir}/lib" "${dir}/extern/openvr/headers")
    file(WRITE "${dir}/lib/CommonLibSSE.lib" "")
    file(WRITE "${dir}/lib/openvr_api.lib" "")
    if(NOT family STREQUAL "-")
        file(WRITE "${dir}/TOOLCHAIN_ID.txt" "${family}")
    endif()
    if(NOT version STREQUAL "-")
        file(WRITE "${dir}/TOOLSET_VERSION.txt" "${version}")
    endif()
endfunction()

bundle(legacy - -)
bundle(legacy_version - 19.44.35207)
bundle(msvc msvc 19.44.35207)
bundle(clangcl clangcl 20.1.7)
bundle(other other 14.2.0)
bundle(unknown intel 2026.1)
bundle(empty_family "" 19.44.35207)
bundle(padded_family " msvc\n" "19.44.35207\n")
bundle(msvc_no_version msvc -)
bundle(clang_no_version clangcl -)
bundle(bad_version msvc "not-a-version")
bundle(empty_version msvc "")
bundle(bad_clang_version clangcl "20.1broken")
bundle(version_directory msvc -)
file(MAKE_DIRECTORY "${_tmp}/version_directory/TOOLSET_VERSION.txt")
bundle(family_directory - 19.44.35207)
file(MAKE_DIRECTORY "${_tmp}/family_directory/TOOLCHAIN_ID.txt")

function(expect name id variant version fixture want)
    set(CMAKE_CXX_COMPILER_ID "${id}")
    set(CMAKE_CXX_COMPILER_FRONTEND_VARIANT "${variant}")
    set(CMAKE_CXX_COMPILER_VERSION "${version}")
    _commonlib_prebuilt_toolset_compatible("${_tmp}/${fixture}" got)
    if(got STREQUAL want)
        message(STATUS "PASS ${name}")
    else()
        message(SEND_ERROR "FAIL ${name}: compatible=${got}, expected ${want}")
    endif()
endfunction()

